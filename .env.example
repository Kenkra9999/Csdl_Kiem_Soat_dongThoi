# Sao chép thành .env; điền thông tin riêng trên máy của bạn.
# DATABASE_URL: tài khoản sở hữu đồ án, chỉ dùng cài đặt và tạo dữ liệu demo.
DATABASE_URL=postgresql://auction19_owner:YOUR_PASSWORD@localhost:5432/auction19_demo
# APP_DATABASE_URL: tài khoản hạn chế quyền cho bid/close/list/verify.
APP_DATABASE_URL=postgresql://auction19_app:YOUR_APP_PASSWORD@localhost:5432/auction19_demo
TEST_DATABASE_URL=postgresql://auction19_owner:YOUR_PASSWORD@localhost:5432/auction19_test
BENCH_DATABASE_URL=postgresql://auction19_owner:YOUR_PASSWORD@localhost:5432/auction19_bench
