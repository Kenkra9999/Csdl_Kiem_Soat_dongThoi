          <mxGeometry x="1025.0" y="2266" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text20" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2625.0" y="2996" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text21" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="5.0" y="2621" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text22" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="4525.0" y="3051" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text23" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2725.0" y="3051" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text24" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="3895.0" y="3051" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text25" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="925.0" y="1966" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text26" value="n" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="3915.0" y="2141" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text27" value="1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55.0" y="511" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text28" value="n" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="4525.0" y="2151" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text29" value="CACH DOC VA QUY UOC THEO TAI LIEU LY THUYET" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="3773" width="722.46484375" height="36" as="geometry" />
        </mxCell>
        <mxCell id="text30" value="Hinh chu nhat: kieu thuc the. Elip: thuoc tinh. Gach chan: khoa; ThuDienTu, MaYeuCau la khoa ung vien thu hai (nhu Sokhung, Somay trang 11)." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="3823" width="2280" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text31" value="Hinh thoi: moi ket hop. Nhan 1:n, n:m, 1:1 la ty so luc luong, dat theo cac vi du trang 20-21." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="3866" width="986.78515625" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text32" value="Duong kep the hien su tham gia toan phan; duong don cho phep khong tham gia. Duong cat nhau co khe ho la khong noi." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="3909" width="1322.45703125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text33" value="Tai san: duong kep toi vong tron D; moi tai san thuoc dung mot trong ba lop con. Cung tap con mo ve lop cha." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="3952" width="1188.7109375" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text34" value="Cac lop con ke thua Ma tai san va toan bo thuoc tinh chung; chi ve thuoc tinh rieng tai lop con." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="3995" width="1018.80078125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text35" value="Dang ky la quan he n:m, co Trang thai dang ky va Thoi diem dang ky. Khi chuyen sang mo hinh quan he, tao bang Dang ky tham gia." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="4038" width="1427.2578125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text36" value="Ket qua dau gia la thuc the yeu, dinh danh bang phien (1:1 nen khong can khoa rieng phan); chu nhat kep, hinh thoi dinh danh kep." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="4081" width="2280" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text37" value="Net dut = du lieu suy dien: GiaHienTai = SoTien lon nhat cua phien; DanDau = luot co SoTien lon nhat. Ban cai dat luu cache, kiem tra khop lich su khi COMMIT." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="4124" width="2280" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text38" value="Nguon ky hieu: tai lieu Mo hinh EER - Khoa CNTT, Dai hoc Sai Gon; trang 6-7, 15, 17-22." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="124" y="4167" width="960.48828125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text39" value="RANG BUOC NGHIEP VU CAN DOC CUNG SO DO" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontColor=#17202a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="3773" width="671.25" height="36" as="geometry" />
        </mxCell>
        <mxCell id="text40" value="1. Nguoi ban va nguoi tham gia la hai vai tro cua Nguoi dung. Chi nguoi dang ky da duyet moi duoc tra gia; nguoi ban khong tu tra tai san cua minh." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="3823" width="1610.10546875" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text41" value="2. Moi luot thuoc dung mot phien va do dung mot nguoi thuc hien. Luot dan dau, luot thang phai thuoc cung phien dang xet." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="3866" width="1340.1171875" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text42" value="3. Luot dau tu gia khoi diem. Luot sau tang it nhat mot buoc va tuan theo luoi gia. Hai yeu cau cung gia: chi mot luot hop le duoc chap nhan." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="3909" width="1529.8203125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text43" value="4. Thoi diem chap nhan: tu luc mo, truoc luc dong. Tra gia va dong phien phai dung chung quy tac giao dich de tranh ket qua mau thuan." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="3952" width="1469.5625" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text44" value="5. Gia hien tai va luot dan dau khop luot cao nhat da chap nhan; chua co luot thi chua co gia hien tai va chua co luot dan dau." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="3995" width="1370.609375" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text45" value="6. Phien dang mo chua co ket qua; phien da dong co dung mot ket qua. Khi khong co luot hop le, ket qua khong co lien ket Luot thang." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="4038" width="1454.73828125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text46" value="7. Ma yeu cau va thu dien tu duy nhat; so se-ri duy nhat khi co. Gui lai cung yeu cau khong tao them luot tra gia." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="4081" width="1209.96875" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text47" value="8. Danh muc co toi da mot cha, co the co nhieu con; khong co chu trinh. Ten danh muc duy nhat trong cung danh muc cha." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="4124" width="1315.4609375" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text48" value="9. Nhat ky thuoc dung mot phien; tac nhan co the vang khi he thong thuc hien. Ghi luot, cap nhat phien va nhat ky trong cung giao dich." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="4167" width="1451.45703125" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text49" value="10. Tai san co the dua ra dau gia nhieu lan theo thoi gian, nhung toi da mot phien dang mo tai moi thoi diem." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#17202a;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2464" y="4210" width="1451.45703125" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>